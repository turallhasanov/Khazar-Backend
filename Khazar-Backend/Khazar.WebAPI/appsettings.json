{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/khazar-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 104857600,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{TraceId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "KhazarDb": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Admin": {
    "Emails": []
  },
  "SuperAdmin": {
    "Email": "superadmin@khazar.az",
    "FirstName": "Super",
    "LastName": "Admin",
    "Password": ""
  },
  "HealthChecks": {
    "MemoryThresholdMb": 1024
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "khazar-api",
    "Audience": "khazar-storefront",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Smtp": {
    "DeliveryMethod": "Smtp",
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "EnableSsl": true,
    "FromEmail": "",
    "FromName": "Khazar",
    "TimeoutSeconds": 15
  },
  "Storefront": {
    "BaseUrl": "",
    "NewsletterDiscountCode": "",
    "NewsletterDiscountPercent": 0
  },
  "Integration": {
    "ApiKey": ""
  },
  "NexusErp": {
    "SyncEnabled": true,
    "BaseUrl": "",
    "Email": "",
    "Password": "",
    "StoreId": "",
    "WarehouseId": "",
    "TimeoutSeconds": 10
  }
}
